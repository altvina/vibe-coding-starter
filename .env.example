# Copy to .env.local and fill in real values. Do not commit .env.local.
#
# Neon (or any Postgres) connection string. Required for:
# - Workspace Admin action requests (run: npm run migrate:action-requests)
# - Super Admin SQL console
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional: default gateway base URLs for Chat / Projects (white-label; overridable in Super Admin UI).
# NEXT_PUBLIC_CHAT_BASE_URL=https://chat.your-brand.com
# NEXT_PUBLIC_PROJECTS_BASE_URL=https://projects.your-brand.com

# --- Future: Google Sign-In (OAuth 2.0) ---
# Create credentials in Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized JavaScript origins: https://your-production-domain
# Authorized redirect URI: must match your auth library callback (e.g. NextAuth or custom /api/auth/callback/google).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Secret for signing session cookies / JWT (use a long random string in production).
# AUTH_SECRET=
#
# If you use NextAuth.js, you also typically need:
# NEXTAUTH_URL=https://your-production-domain
# NEXTAUTH_SECRET=${AUTH_SECRET}
